    {
      "type": "table",
      "title": "Trạng thái thu thập metrics (Prometheus targets)",
      "description": "1 = Prometheus đọc được metrics từ nguồn, 0 = lỗi.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
