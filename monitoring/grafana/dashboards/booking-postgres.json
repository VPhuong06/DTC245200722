    {
      "type": "stat",
      "title": "Cache hit",
      "description": "Tỉ lệ đọc block từ bộ nhớ đệm thay vì từ đĩa.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"booking\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"booking\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"booking\"}[5m])), 1e-9) * 100",
          "legendFormat": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "id": 5,
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 5,
        "h": 4
      }
