# Mẫu biến môi trường – KHÔNG chứa mật khẩu thật.
# Tạo .env với mật khẩu ngẫu nhiên:  ./scripts/gen-env.sh
# Hoặc sao chép thủ công: cp .env.example .env  rồi thay mọi CHANGE_ME
# (mật khẩu tối thiểu 16 ký tự, ví dụ sinh bằng: openssl rand -base64 24)

# --- Cổng publish ra máy chủ (chỉ Nginx) ---
HTTP_PORT=80
HTTPS_PORT=443
PUBLIC_URL=https://localhost

# --- PostgreSQL ---
POSTGRES_DB=booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# User ứng dụng: chỉ có quyền trên schema "app", không phải superuser
APP_DB_USER=booking_app
APP_DB_PASSWORD=CHANGE_ME
# User cho postgres_exporter (commit 2): chỉ có quyền pg_monitor
EXPORTER_DB_PASSWORD=CHANGE_ME

# --- Backend ---
# Khóa ký phiên đăng nhập, tối thiểu 32 ký tự
JWT_SECRET=CHANGE_ME
# Tài khoản quản trị đầu tiên (tạo khi hệ thống chưa có người dùng), mật khẩu tối thiểu 12 ký tự
ADMIN_EMAIL=admin@annhien.vn
ADMIN_PASSWORD=CHANGE_ME
# Nạp dữ liệu mẫu (dịch vụ, nhân viên, lịch hẹn quanh ngày hiện tại) khi cơ sở dữ liệu còn trống
SEED_DEMO=true
# Hệ số nhân giới hạn tốc độ trong ứng dụng; tăng lên (ví dụ 10) khi chạy kiểm thử tải
RATE_LIMIT_MULTIPLIER=1

# --- pgAdmin (https://localhost/pgadmin/) ---
PGADMIN_DEFAULT_EMAIL=admin@annhien.vn
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME

# --- Giám sát (commit 2) ---
# Grafana: https://localhost/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Prometheus: https://localhost/prometheus/ (Nginx basic auth, tạo bằng ./scripts/gen-htpasswd.sh)
PROMETHEUS_WEB_USER=admin
PROMETHEUS_WEB_PASSWORD=CHANGE_ME

# --- Email (không bắt buộc; để trống thì worker chỉ ghi log, đánh dấu email "skipped") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hẹn · An Nhiên Studio <no-reply@annhien.vn>
SMTP_SECURE=false
